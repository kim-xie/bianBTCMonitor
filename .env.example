# BTC交易系统环境配置示例

# MongoDB配置
MONGODB_URI=mongodb://localhost:27017/btc-trading

# JWT配置
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d

# 服务器端口
PORT=3001

# 币安API代理配置（可选）
# 如果不使用代理，请注释掉以下配置

# PROXY_HOST=your-proxy-server.com
# PROXY_PORT=8080
# PROXY_USER=your-username
# PROXY_PASS=your-password

# 示例配置（请根据实际情况修改）:
# PROXY_HOST=proxy.company.com
# PROXY_PORT=3128
# PROXY_USER=john.doe
# PROXY_PASS=secret123