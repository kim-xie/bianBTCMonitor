# ============================================================
# BTC 交易系统环境配置示例
# 复制本文件为 .env 并填入真实值（.env 已被 .gitignore 忽略）
# 生产环境（Render）请在平台环境变量中配置，不要提交到代码仓库
# ============================================================

# MongoDB 配置
# 本地开发使用本地 MongoDB，生产环境使用 MongoDB Atlas（托管数据库）
MONGODB_URI=mongodb://localhost:27017/btc-trading
# MongoDB Atlas 示例（生产环境推荐）：
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/btc-trading?retryWrites=true&w=majority

# JWT 配置
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d

# 服务器端口
PORT=3001

# 飞书机器人 Webhook（可选，用于推送交易信号/平仓通知）
FEISHU_WEBHOOK_URL=

# 币安 API 代理配置（可选）
# 本地开发若需科学上网访问币安，请配置代理；生产服务器若可直连则留空
# PROXY_HOST=127.0.0.1
# PROXY_PORT=7890
# PROXY_USER=
# PROXY_PASS=
